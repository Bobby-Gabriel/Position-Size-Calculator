QWidget {
    background-color: #0f0f0f;
    color: #e8e8e8;
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 11pt;
}
QPushButton {
   background-color: #0d7377;
   color: white;
   border: none;
   padding: 12px 20px;
   border-radius: 8px;
   font-weight: 600;
   font-size: 11pt;
}
QPushButton:hover {
   background-color: #14a085;
}
QPushButton:pressed {
   background-color: #0a5f63;
}
QLineEdit {
   background-color: #1a1a1a;
   color: #ffffff;
   border: 1.5px solid #2a2a2a;
   border-radius: 8px;
   padding: 12px 16px;
   font-size: 13pt;
   font-weight: 500;
   selection-background-color: #0d7377;
}
QLineEdit:focus {
   border: 1.5px solid #0d7377;
   background-color: #1f1f1f;
}
QLabel {
   color: #b0b0b0;
   font-size: 10pt;
   font-weight: 500;
   letter-spacing: 0.3px;
}

QLabel#inputLabel {
   font-size: 9pt;
   color: #808080;
   font-weight: 600;
   letter-spacing: 1px;
}

QLabel#resultValue {
   font-size: 28pt;
   font-weight: 700;
   color: #0d7377;
   margin-top: 20px;
   padding: 20px;
   background-color: #141414;
   border-radius: 12px;
   border: 2px solid #1f1f1f;
}

QLabel#resultLabel {
   font-size: 9pt;
   color: #808080;
   font-weight: 600;
   letter-spacing: 1px;
   margin-top: 20px;
}